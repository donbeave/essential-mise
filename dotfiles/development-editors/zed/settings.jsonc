{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "colorize_brackets": true,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "base_keymap": "JetBrains",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Dark",
    "dark": "Ayu Dark",
  },
}
