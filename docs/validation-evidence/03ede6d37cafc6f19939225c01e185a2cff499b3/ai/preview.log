mise bootstrap: post-packages hooks
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula fff-mcp >/dev/null 2>&1; then /opt/homebrew/bin/brew install dmtrKovalenko/fff/fff-mcp; fi'
sh -o errexit -c '/opt/homebrew/bin/fff-mcp --healthcheck'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --cask claude-code@latest >/dev/null 2>&1; then /opt/homebrew/bin/brew install --cask claude-code@latest; fi'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula ampcode >/dev/null 2>&1; then /opt/homebrew/bin/brew install ampcode/tap/ampcode; fi'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula omp >/dev/null 2>&1; then /opt/homebrew/bin/brew install can1357/tap/omp; fi'
sh -o errexit -c '/opt/homebrew/bin/claude --version'
sh -o errexit -c '/opt/homebrew/bin/amp --version'
sh -o errexit -c '/opt/homebrew/bin/omp --version'
