mise bootstrap: post-packages hooks
sh -o errexit -c '/opt/homebrew/bin/gh config set git_protocol https'
sh -o errexit -c '/opt/homebrew/bin/gh config set editor '\'''\'''
sh -o errexit -c '/opt/homebrew/bin/gh config set prompt enabled'
sh -o errexit -c '/opt/homebrew/bin/gh config set prefer_editor_prompt disabled'
sh -o errexit -c '/opt/homebrew/bin/gh config set pager '\'''\'''
sh -o errexit -c '/opt/homebrew/bin/gh alias set co '\''pr checkout'\'' --clobber'
sh -o errexit -c '/opt/homebrew/bin/gh config set http_unix_socket '\'''\'''
sh -o errexit -c '/opt/homebrew/bin/gh config set browser '\'''\'''
sh -o errexit -c '/opt/homebrew/bin/gh config set color_labels disabled'
sh -o errexit -c '/opt/homebrew/bin/gh config set accessible_colors disabled'
sh -o errexit -c '/opt/homebrew/bin/gh config set accessible_prompter disabled'
sh -o errexit -c '/opt/homebrew/bin/gh config set spinner enabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get git_protocol)" = https'
sh -o errexit -c 'test -z "$(/opt/homebrew/bin/gh config get editor)"'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get prompt)" = enabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get prefer_editor_prompt)" = disabled'
sh -o errexit -c 'test -z "$(/opt/homebrew/bin/gh config get pager)"'
sh -o errexit -c 'test -z "$(/opt/homebrew/bin/gh config get http_unix_socket)"'
sh -o errexit -c 'test -z "$(/opt/homebrew/bin/gh config get browser)"'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get color_labels)" = disabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get accessible_colors)" = disabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get accessible_prompter)" = disabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get spinner)" = enabled'
sh -o errexit -c 'test "$(/opt/homebrew/bin/gh config get version)" = 1'
sh -o errexit -c '/opt/homebrew/bin/gh alias list | /usr/bin/grep -E '\''^co:[[:space:]]+pr checkout$'\'''
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --cask surge >/dev/null 2>&1; then
  if [ -e /Applications/Surge.app ] || [ -e "/Applications/Surge Dashboard.app" ] || [ -L "/Applications/Surge Dashboard.app" ]; then
    printf '\''Existing Surge applications require manual ownership migration before using Homebrew.\n'\'' >&2
    exit 1
  fi
  /opt/homebrew/bin/brew install --cask surge
fi
test -x /opt/homebrew/bin/surge-cli
test -x /opt/homebrew/sbin/surge-dhcpd
/usr/bin/codesign --verify --deep --strict /Applications/Surge.app'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula fff-mcp >/dev/null 2>&1; then /opt/homebrew/bin/brew install dmtrKovalenko/fff/fff-mcp; fi'
sh -o errexit -c '/opt/homebrew/bin/fff-mcp --healthcheck'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --cask claude-code@latest >/dev/null 2>&1; then /opt/homebrew/bin/brew install --cask claude-code@latest; fi'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula ampcode >/dev/null 2>&1; then /opt/homebrew/bin/brew install ampcode/tap/ampcode; fi'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --formula omp >/dev/null 2>&1; then /opt/homebrew/bin/brew install can1357/tap/omp; fi'
sh -o errexit -c '/opt/homebrew/bin/claude --version'
sh -o errexit -c '/opt/homebrew/bin/amp --version'
sh -o errexit -c '/opt/homebrew/bin/omp --version'
sh -o errexit -c 'if ! /opt/homebrew/bin/brew list --cask amp@beta >/dev/null 2>&1; then
  if [ -d /Applications/Amp.app ]; then
    printf '\''Existing /Applications/Amp.app requires manual ownership migration before using Homebrew.\n'\'' >&2
    exit 1
  fi
  /opt/homebrew/bin/brew install --cask ampcode/tap/amp@beta
fi
